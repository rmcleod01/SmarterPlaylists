#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [[ -f "${SCRIPT_DIR}/credentials.sh" ]]; then
  # shellcheck source=/dev/null
  source "${SCRIPT_DIR}/credentials.sh"
fi

if [[ -f "${ROOT_DIR}/.env" ]]; then
  set -a
  # shellcheck source=/dev/null
  source "${ROOT_DIR}/.env"
  set +a
fi

# export PBL_NO_CACHE=1
export PBL_CACHE=REDIS
export SPOTIPY_REDIRECT_URI="${SPOTIPY_REDIRECT_URI:-https://localhost:8000/auth.html}"
export SSL_CERT="${SSL_CERT:-${ROOT_DIR}/certs/dev.crt}"
export SSL_KEY="${SSL_KEY:-${ROOT_DIR}/certs/dev.key}"

PYTHON_BIN="${PYTHON_BIN:-python2}"
if ! command -v "${PYTHON_BIN}" >/dev/null 2>&1; then
  echo "Missing ${PYTHON_BIN}. Set PYTHON_BIN to your Python 2 executable." >&2
  exit 1
fi

"${PYTHON_BIN}" flask_server.py --debug
